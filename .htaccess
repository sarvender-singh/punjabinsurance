RewriteEngine On

# Redirect mail.punjabinsurance.ca (http or https) to the main domain
RewriteCond %{HTTP_HOST} ^mail\.punjabinsurance\.ca$ [NC]
RewriteRule ^(.*)$ https://punjabinsurance.ca/$1 [R=301,L]

# === Force HTTPS + www for punjabinsurance.ca only ===

RewriteCond %{HTTP_HOST} ^(www\.)?punjabinsurance\.ca$ [NC]

RewriteCond %{HTTPS} off [OR]

RewriteCond %{HTTP_HOST} ^punjabinsurance\.ca$ [NC]

RewriteRule ^ https://www.punjabinsurance.ca%{REQUEST_URI} [L,R=301] 

# ==========================================

# === Added on 27-06-2026 ===

# ==========================================

RewriteCond %{REQUEST_URI} ^/index\.php$

RewriteRule ^index\.php$ / [R=301,L]

# ==========================================
# === SUPER VISA INSURANCE REDIRECT ===
# ==========================================

RewriteRule ^super-visa-insurance/?$ /super-visa-insurance.php [R=301,L]


# === 410 GONE: removed pages ===
RewriteRule ^google-reviews\.php$ - [G,L]

# ==========================================

# === BLOG ROUTING RULES (ADDED FOR SEO) ===

# ==========================================

# === DYNAMIC XML SITEMAP ===
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ==========================================

# === BLOG ROUTING RULES (ADDED FOR SEO) ===

# ==========================================



# 1. Category Filter ke liye (Ab ye blogs-archive.php page par jayega)

RewriteRule ^blog/category/([^/]+)/?$ blogs-archive.php?cat_slug=$1 [L,QSA]



# 2. Single Blog Detail Page ke liye

RewriteRule ^blog/([^/]+)/?$ blogs-single.php?slug=$1 [L,QSA]



# 3. Main Blog Listing Page

RewriteRule ^blogs/?$ blogs.php [L,QSA]



# ==========================================



# ==========================================



<IfModule mime_module>

 AddType application/x-httpd-ea-php56 .php .php5 .phtml

</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
